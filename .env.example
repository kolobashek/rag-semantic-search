# Скопируйте в .env и задайте значения перед `docker compose up`.
# Пустые креды MinIO — контейнер хранилища не стартует (это намеренно).

# Учётные данные объектного хранилища Cloud Drive (S3/MinIO).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=rag-catalog

# Секрет подписи сессионных cookie веб-интерфейса.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
RAG_UI_STORAGE_SECRET=

# Пути и порты
RAG_CATALOG_PATH=O:/Обмен
RAG_CONFIG_PATH=./config.docker.json
RAG_WEB_PORT=8080
